        let activeTab = 'ALL';

        // Filter Function
        function filterPrograms() {
            const query = document.getElementById('program-search').value.toLowerCase().trim();
            const container = document.getElementById('program-list');
            const noResults = document.getElementById('no-results');

            container.innerHTML = '';

            const filtered = programData.filter(item => {
                const matchesTab = (activeTab === 'ALL') || (item.type === activeTab);
                const matchesSearch = 
                    item.carrera.toLowerCase().includes(query) ||
                    item.facultad.toLowerCase().includes(query) ||
                    item.campus.toLowerCase().includes(query) ||
                    item.id.toLowerCase().includes(query) ||
                    item.correo.toLowerCase().includes(query) ||
                    item.programName.toLowerCase().includes(query);

                return matchesTab && matchesSearch;
            });

            if (filtered.length === 0) {
                noResults.classList.remove('hidden');
            } else {
                noResults.classList.add('hidden');
                filtered.forEach(item => {
                    container.appendChild(createProgramCard(item));
                });
            }
        }

        // Card HTML Generator
        function createProgramCard(item) {
            const card = document.createElement('div');
            card.className = "bg-white rounded-xl border border-slate-200 p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between space-y-4";

            let badgeBg = "bg-emerald-100 text-emerald-800 border-emerald-300";
            let badgeText = "Servicio Social Comunitario (SSC)";

            if(item.type === 'SSP') {
                badgeBg = "bg-sky-100 text-sky-800 border-sky-300";
                badgeText = "Servicio Social Profesional (SSP)";
            } else if(item.type === 'PP') {
                badgeBg = "bg-amber-100 text-amber-900 border-amber-300";
                badgeText = "Prácticas Profesionales (PP)";
            }

            card.innerHTML = `
                <div>
                    <div class="flex items-center justify-between gap-2 mb-2">
                        <span class="text-[10px] font-bold px-2.5 py-0.5 rounded-full border ${badgeBg}">
                            ${badgeText}
                        </span>
                        <span class="text-[10px] font-mono bg-slate-100 text-slate-600 px-2 py-0.5 rounded border border-slate-200">
                            ID: ${item.id}
                        </span>
                    </div>

                    <h4 class="font-bold text-slate-900 text-sm leading-snug mb-1">${item.carrera}</h4>
                    <p class="text-xs text-slate-500 font-medium">${item.facultad}</p>
                    <p class="text-[11px] text-slate-400 mt-0.5"><i class="fas fa-map-marker-alt text-slate-400 mr-1"></i> Campus ${item.campus}</p>
                    
                    <div class="mt-3 pt-3 border-t border-slate-100 space-y-1 text-xs">
                        <p class="text-slate-700 font-semibold truncate" title="${item.programName}">
                            <i class="fas fa-project-diagram text-slate-400 mr-1.5"></i> ${item.programName}
                        </p>
                        ${item.cupo ? `<p class="text-slate-600 font-medium"><i class="fas fa-users text-slate-400 mr-1.5"></i> ${item.cupo}</p>` : ''}
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-100 bg-slate-50 -mx-5 -mb-5 p-4 rounded-b-xl space-y-1.5 text-xs">
                    <p class="text-slate-700">
                        <span class="font-bold">Responsable:</span> ${item.responsable}
                    </p>
                    <a href="mailto:${item.correo}" class="inline-flex items-center font-bold text-uabc-green hover:underline text-xs break-all">
                        <i class="fas fa-envelope mr-1.5 text-slate-400"></i> ${item.correo}
                    </a>
                </div>
            `;

            return card;
        }

        // Set Tab Filter
        function setTab(tabType) {
            activeTab = tabType;

            document.querySelectorAll('.tab-btn').forEach(btn => {
                btn.className = "tab-btn px-4 py-2 text-xs font-bold rounded-lg bg-white border border-slate-300 text-slate-700 hover:bg-slate-100";
            });

            const activeBtn = document.getElementById(`tab-${tabType}`);
            if(activeBtn) {
                activeBtn.className = "tab-btn px-4 py-2 text-xs font-bold rounded-lg bg-uabc-green text-white shadow-sm";
            }

            filterPrograms();
        }

        // Update Counts on Load
        function updateCounts() {
            document.getElementById('count-ALL').innerText = programData.length;
            document.getElementById('count-SSC').innerText = programData.filter(i => i.type === 'SSC').length;
            document.getElementById('count-SSP').innerText = programData.filter(i => i.type === 'SSP').length;
            document.getElementById('count-PP').innerText = programData.filter(i => i.type === 'PP').length;
        }

        // Mobile Menu Navigation toggle
        const mobileMenuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');

        if(mobileMenuBtn) {
            mobileMenuBtn.addEventListener('click', () => {
                mobileMenu.classList.toggle('hidden');
            });
        }

        // Initialize on Window Load
        window.onload = function() {
            updateCounts();
            filterPrograms();
        };
    </script>
</body>
</html>
